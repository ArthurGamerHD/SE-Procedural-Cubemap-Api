<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netframework48</TargetFramework>
        <RootNamespace>VoxelCubemapApi</RootNamespace>
        <LangVersion>6</LangVersion>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <Configurations>Release;Debug</Configurations>
        <Platforms>x64</Platforms>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <LcdModCodeGeneratorSkipAppConfig>true</LcdModCodeGeneratorSkipAppConfig>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Mal.Mdk2.ModAnalyzers" Version="2.1.16">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Mal.Mdk2.ModPackager" Version="2.2.10">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Mal.Mdk2.References" Version="2.2.8">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>
    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
        <CompilerVisibleProperty Include="LcdModCodeGeneratorSkipAppConfig"/>
        <ProjectReference Include="..\External\Arthur-s-Lcd-Mod\LcdModCodeGenerator\LcdModCodeGenerator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"/>
    </ItemGroup>
    <ItemGroup Condition="'$(Configuration)' != 'Debug'">
        <Compile Remove="Client\DebugGrassPlanetClient.cs"/>
    </ItemGroup>
    <ItemGroup>
        <Compile Include="..\External\Arthur-s-Lcd-Mod\Arthur-s-Lcd-Mod\Common\Compression\**\*.cs"
                 Link="Common\Compression\%(RecursiveDir)%(Filename)%(Extension)"/>
        <Compile Include="..\External\Arthur-s-Lcd-Mod\Arthur-s-Lcd-Mod\Common\Exceptions\**\*.cs"
                 Link="Common\Exceptions\%(RecursiveDir)%(Filename)%(Extension)"/>
        <Compile Include="..\External\Arthur-s-Lcd-Mod\Arthur-s-Lcd-Mod\Common\Zip\**\*.cs"
                 Link="Common\Zip\%(RecursiveDir)%(Filename)%(Extension)"/>
    </ItemGroup>
    <ItemGroup>
        <AdditionalFiles Include="Content\*\**\*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </AdditionalFiles>
        <AdditionalFiles Include="thumb.png" Condition="Exists('thumb.png')">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </AdditionalFiles>
        <AdditionalFiles Remove="Content\*\**\*.cs"/>
        <AdditionalFiles Remove="Content\Other content folders"/>
        <AdditionalFiles Remove="Content\Data\SBC files can go here"/>
        <None Remove="thumb.png"/>
    </ItemGroup>
</Project>
