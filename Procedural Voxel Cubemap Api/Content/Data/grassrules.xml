<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <!--
    This is a data-only carrier for the terraform surface recipe.
    DebugGrassPlanetClient reads only the MaterialGroup named
    "TerraformGrassSurface"; this is not registered as a planet definition.

    The material rules use normal Space Engineers planet material syntax, so
    the recipe can vary by Height, Latitude, Longitude and Slope without any
    matching logic being hard-coded in C#.
  -->
  <Definition xsi:type="PlanetGeneratorDefinition">
    <Id>
      <TypeId>PlanetGeneratorDefinition</TypeId>
      <SubtypeId>TerraformGrassRules</SubtypeId>
    </Id>

    <ComplexMaterials>
      <MaterialGroup Name="TerraformGrassSurface" Value="0">
        <!-- Main grass band. -->
        <Rule>
          <Layers>
            <Layer Material="Grass" Depth="1"/>
            <Layer Material="Soil" Depth="4"/>
          </Layers>
          <Height Min="0" Max="1"/>
          <Latitude Min="0" Max="90"/>
          <Slope Min="0" Max="25"/>
        </Rule>

        <!-- Broken/rocky grass on medium slopes. -->
        <Rule>
          <Layers>
            <Layer Material="Rocks_grass" Depth="1"/>
            <Layer Material="Soil" Depth="4"/>
          </Layers>
          <Height Min="0" Max="1"/>
          <Latitude Min="0" Max="90"/>
          <Slope Min="25" Max="40"/>
        </Rule>

        <!-- Exposed dirt on steep terrain. -->
        <Rule>
          <Layers>
            <Layer Material="Soil" Depth="5"/>
          </Layers>
          <Height Min="0" Max="1"/>
          <Latitude Min="0" Max="90"/>
          <Slope Min="40" Max="90"/>
        </Rule>
      </MaterialGroup>
    </ComplexMaterials>
  </Definition>
</Definitions>
