        <Slope Min="0" Max="50"/>
      </Mapping>
      <Mapping>
        <Material>Grass_old</Material>
        <Biome>198</Biome>
        <Item Type="Tree" Subtype="GrassOldForestLarge" Density="0.07"/>
        <Item Type="Bush" Subtype="GrassOldBushForestLarge" Density="0.15"/>
        <Height Min="0" Max="0.7"/>
        <Latitude Min="20" Max="75" Mirror="true"/>
        <Slope Min="0" Max="50"/>
      </Mapping>
      <Mapping>
        <Material>Sand_02</Material>
        <Biome>198</Biome>
        <Item Type="Tree" Subtype="SandForestLarge" Density="0.01"/>
        <Item Type="Bush" Subtype="SandBushForestLarge" Density="0.0025"/>
        <Height Min="0" Max="0.7"/>
        <Latitude Min="0" Max="75" Mirror="true"/>
        <Slope Min="0" Max="50"/>
      </Mapping>
      <Mapping>
        <Material>Woods_grass</Material>
        <Material>Grass</Material>
        <Material>Grass_old</Material>
        <Material>Soil</Material>
        <Biome>85</Biome>
        <Biome>87</Biome>
        <Biome>113</Biome>
        <Biome>141</Biome>
        <Biome>198</Biome>
        <Item Type="Forageable" Subtype="EarthForageables" Density="0.004"/>
        <Height Min="0" Max="1"/>
        <Latitude Min="0" Max="90" Mirror="true"/>
        <Slope Min="0" Max="20"/>
      </Mapping>
    </EnvironmentMappings>
  </Definition>
  <Definition xsi:type="PlanetGeneratorDefinition">
    <Id Type="MyObjectBuilder_PlanetGeneratorDefinition" Subtype="VoxelCubemapGrassEnvironmentCarrier"/>
    <Environment Type="ProceduralWorldEnvironment" Subtype="VoxelCubemapGrassEnvironment"/>
  </Definition>
</Definitions>
