        <Material>Grass</Material>
        <Biome>141</Biome>
        <Item Type="Tree" Subtype="GrassForestMedium" Density="0.6"/>
        <Item Type="Bush" Subtype="GrassBushForestMedium" Density="0.2"/>
        <Height Min="0" Max="0.7"/>
        <Latitude Min="0" Max="75" Mirror="true"/>
        <Slope Min="0" Max="50"/>
      </Mapping>
      <Mapping>
        <Material>Grass_old</Material>
        <Biome>141</Biome>
        <Item Type="Tree" Subtype="GrassOldForestMedium" Density="0.15"/>
        <Item Type="Bush" Subtype="GrassOldBushForestMedium" Density="0.225"/>
        <Height Min="0" Max="0.7"/>
        <Latitude Min="20" Max="75" Mirror="true"/>
        <Slope Min="0" Max="50"/>
      </Mapping>
      <Mapping>
        <Material>Sand_02</Material>
        <Biome>141</Biome>
        <Item Type="Tree" Subtype="SandForestMedium" Density="0.15"/>
        <Item Type="Bush" Subtype="SandBushForestMedium" Density="0.1"/>
        <Height Min="0" Max="0.7"/>
        <Latitude Min="0" Max="75" Mirror="true"/>
        <Slope Min="0" Max="50"/>
      </Mapping>
      <Mapping>
        <Material>Snow</Material>
        <Biome>198</Biome>
        <Item Type="Tree" Subtype="SnowForestLarge" Density="0.6"/>
        <Item Type="Bush" Subtype="SnowBushForestLarge" Density="0.2"/>
        <Height Min="0" Max="0.7"/>
        <Latitude Min="0" Max="75" Mirror="true"/>
