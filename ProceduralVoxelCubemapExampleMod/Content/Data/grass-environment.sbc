      </Mapping>
      <Mapping>
        <Material>Woods_grass</Material>
        <Biome>198</Biome>
        <Item Type="Tree" Subtype="WoodGrassForestLarge" Density="0.6"/>
        <Item Type="Bush" Subtype="WoodGrassBushForestLarge" Density="0.2"/>
        <Height Min="0" Max="0.7"/>
        <Latitude Min="0" Max="75" Mirror="true"/>
