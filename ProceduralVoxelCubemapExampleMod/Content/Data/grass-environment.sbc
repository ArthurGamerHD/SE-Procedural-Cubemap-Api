      </Mapping>
      <Mapping>
        <Material>Rocks_grass</Material>
        <Biome>198</Biome>
        <Item Type="Tree" Subtype="RockGrassForestLarge" Density="0.35"/>
        <Item Type="Bush" Subtype="RockGrassBushForestLarge" Density="0.1"/>
        <Height Min="0" Max="0.7"/>
        <Latitude Min="0" Max="75" Mirror="true"/>
        <Slope Min="0" Max="50"/>
      </Mapping>
      <Mapping>
        <Material>Grass</Material>
        <Biome>198</Biome>
        <Item Type="Tree" Subtype="GrassForestLarge" Density="0.6"/>
        <Item Type="Bush" Subtype="GrassBushForestLarge" Density="0.2"/>
        <Height Min="0" Max="0.7"/>
