<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG/CALLER EXAMPLE. This is a real game definition file, not runtime data.
  The procedural environment is loaded and postprocessed by Keen during normal
  definition loading. The tiny PlanetGeneratorDefinition exists only as a
  whitelist-safe carrier so Voxel Cubemap Api can ask MyPlanet.Init() to create
  the environment component without referencing the private planet namespace.

  DestroyableItems densities were halved to preserve FromLegacyPlanet() behavior.
  The single grouped voxel-map legacy item is intentionally omitted; this sample
  is vegetation-only.
-->
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Definition xsi:type="VR.ProceduralWorldEnvironment">
    <Id Type="MyObjectBuilder_ProceduralWorldEnvironment" Subtype="VoxelCubemapGrassEnvironment"/>
    <SectorSize>200</SectorSize>
    <ItemsPerSqMeter>0.0034</ItemsPerSqMeter>
    <MaxSyncLod>0</MaxSyncLod>
    <ItemTypes>
      <Item Name="Tree">
        <LodFrom>-1</LodFrom>
        <LodTo>1</LodTo>
        <Provider Type="MyObjectBuilder_ProceduralEnvironmentModuleDefinition" Subtype="Static"/>
        <Proxy Type="MyObjectBuilder_EnvironmentModuleProxyDefinition" Subtype="Breakable"/>
      </Item>
      <Item Name="Bush">
        <LodFrom>0</LodFrom>
        <LodTo>-1</LodTo>
        <Provider Type="MyObjectBuilder_ProceduralEnvironmentModuleDefinition" Subtype="Static"/>
        <Proxy Type="MyObjectBuilder_EnvironmentModuleProxyDefinition" Subtype="Breakable"/>
      </Item>
      <Item Name="Forageable">
        <LodFrom>-1</LodFrom>
        <LodTo>1</LodTo>
        <Provider Type="MyObjectBuilder_ProceduralEnvironmentModuleDefinition" Subtype="Static"/>
        <Proxy Type="MyObjectBuilder_EnvironmentModuleProxyDefinition" Subtype="Forageable"/>
      </Item>
    </ItemTypes>
    <EnvironmentMappings>
      <Mapping>
        <Material>Snow</Material>
        <Biome>113</Biome>
        <Item Type="Tree" Subtype="SnowForestEdge" Density="0.3"/>
        <Item Type="Bush" Subtype="SnowBushForestEdge" Density="0.2"/>
        <Height Min="0" Max="0.7"/>
        <Latitude Min="0" Max="75" Mirror="true"/>
        <Slope Min="0" Max="50"/>
      </Mapping>
      <Mapping>
        <Material>Woods_grass</Material>
        <Biome>113</Biome>
        <Item Type="Tree" Subtype="WoodGrassForestEdge" Density="0.3"/>
        <Item Type="Bush" Subtype="WoodGrassBushForestEdge" Density="0.2"/>
        <Height Min="0" Max="0.7"/>
        <Latitude Min="0" Max="75" Mirror="true"/>
        <Slope Min="0" Max="50"/>
      </Mapping>
      <Mapping>
        <Material>Rocks_grass</Material>
        <Biome>113</Biome>
        <Item Type="Tree" Subtype="RockGrassForestEdge" Density="0.45"/>
        <Item Type="Bush" Subtype="RockGrassBushForestEdge" Density="0.2"/>
        <Height Min="0" Max="0.7"/>
        <Latitude Min="0" Max="75" Mirror="true"/>
        <Slope Min="0" Max="50"/>
      </Mapping>
      <Mapping>
        <Material>Grass</Material>
        <Biome>113</Biome>
        <Item Type="Tree" Subtype="GrassForestEdge" Density="0.1"/>
        <Item Type="Bush" Subtype="GrassBushForestEdge" Density="0.2"/>
        <Height Min="0" Max="0.7"/>
        <Latitude Min="0" Max="75" Mirror="true"/>
        <Slope Min="0" Max="50"/>
      </Mapping>
      <Mapping>
        <Material>Grass_old</Material>
        <Biome>113</Biome>
        <Item Type="Tree" Subtype="GrassForestEdge" Density="0.03"/>
        <Item Type="Tree" Subtype="GrassOldForestEdge" Density="0.06"/>
        <Item Type="Bush" Subtype="GrassOldBushForestEdge" Density="0.25"/>
        <Height Min="0" Max="0.7"/>
        <Latitude Min="20" Max="75" Mirror="true"/>
        <Slope Min="0" Max="50"/>
      </Mapping>
      <Mapping>
        <Material>Grass_old</Material>
        <Biome>113</Biome>
        <Item Type="Tree" Subtype="GrassOldForestEdge" Density="0.06"/>
        <Item Type="Bush" Subtype="GrassOldBushForestEdge" Density="0.25"/>
        <Height Min="0" Max="0.7"/>
        <Latitude Min="0" Max="20" Mirror="true"/>
        <Slope Min="0" Max="50"/>
      </Mapping>
      <Mapping>
