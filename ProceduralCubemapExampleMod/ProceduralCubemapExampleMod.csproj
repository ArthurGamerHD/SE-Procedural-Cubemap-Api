<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netframework48</TargetFramework>
    <RootNamespace>CubemapExampleMod</RootNamespace>
    <LangVersion>6</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Configurations>Release;Debug</Configurations>
    <Platforms>x64</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Mal.Mdk2.ModAnalyzers" Version="2.1.16">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Mal.Mdk2.ModPackager" Version="2.2.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Mal.Mdk2.References" Version="2.2.9">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\External\Adk\Adk.Analyzer\Adk.Analyzer.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false">
      <SetPlatform>Platform=AnyCPU</SetPlatform>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="Content\*\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </AdditionalFiles>
    <AdditionalFiles Remove="Content\*\**\*.cs" />
    <AdditionalFiles Remove="Content\Other content folders" />
    <AdditionalFiles Remove="Content\Data\SBC files can go here" />
    <None Remove="thumb.png" />
  </ItemGroup>

  <Target Name="Mapjpgtopng" BeforeTargets="PostBuildEvent">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\thumb.jpg"
          DestinationFiles="$(MSBuildProjectDirectory)\thumb.png"
          SkipUnchangedFiles="true"/>
  </Target>

  <Target Name="RemoveThumbAlias" AfterTargets="MdkPack;MdkDidNotPack">
    <Delete Files="$(MSBuildProjectDirectory)\thumb.png" />
  </Target>

  <Import Project="..\ClientApi\ClientApi.projitems" Label="Shared" />
</Project>
